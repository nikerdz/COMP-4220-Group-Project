<Window x:Class="BookStoreGUI.Pages.UserAddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Editor"
        Height="360"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- INPUT FORM -->
        <StackPanel Grid.Row="0">

            <!-- Username -->
            <TextBlock Text="Username:" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Margin="0,0,0,12"/>

            <!-- Password -->
            <TextBlock Text="Password:" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,12"/>

            <!-- Type -->
            <TextBlock Text="Type:" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbType"
                      Width="120"
                      Margin="0,0,0,12">
                <ComboBoxItem Content="AD"/>
                <ComboBoxItem Content="CU"/>
            </ComboBox>

            <!-- Manager -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Is Manager:" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkManager" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Full Name -->
            <TextBlock Text="Full Name:" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtFullName" Margin="0,0,0,12"/>

            <!-- Email -->
            <TextBlock Text="Email:" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtEmail" Margin="0,0,0,12"/>

        </StackPanel>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="OK"
                    Width="80"
                    Margin="6,0,0,0"
                    IsDefault="True"
                    Click="Ok_Click"/>

            <Button Content="Cancel"
                    Width="80"
                    Margin="6,0,0,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>

    </Grid>
</Window>
