<UserControl x:Class="BookStoreGUI.Pages.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Inventory Management"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add"
                        Width="90"
                        Margin="12,0,0,0"
                        Click="BtnAdd_Click"/>

                <Button Content="Edit"
                        Width="90"
                        Margin="12,0,0,0"
                        Click="BtnEdit_Click"/>

                <Button Content="Delete"
                        Width="90"
                        Margin="12,0,0,0"
                        Background="#CC3B3B"
                        Foreground="White"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- INVENTORY TABLE -->
        <DataGrid x:Name="InventoryGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="All"
                  Margin="0"
                  AlternatingRowBackground="#F5F5F5"
                  AlternationCount="2">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="120"/>
                <DataGridTextColumn Header="Category ID" Binding="{Binding CategoryID}" Width="100"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="250"/>
                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="180"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="80"/>

                <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="80"/>
                <DataGridTextColumn Header="Edition" Binding="{Binding Edition}" Width="80"/>
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="150"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding InStock}" Width="80"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>

</UserControl>
