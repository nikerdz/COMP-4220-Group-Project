<UserControl x:Class="BookStoreGUI.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ORDERS HEADER -->
        <TextBlock Text="Orders" FontSize="20" FontWeight="Bold" />

        <!-- ORDERS GRID -->
        <DataGrid x:Name="OrdersGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="True"
                  SelectionChanged="OrdersGrid_SelectionChanged"
                  Height="250"
                  Margin="0,8,0,12" />

        <!-- ORDER DETAILS HEADER -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Order Items" FontSize="18" FontWeight="Bold" />
        </StackPanel>

        <!-- ORDER ITEMS GRID -->
        <DataGrid x:Name="OrderItemsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="True"
                  Height="250"
                  Margin="0,8,0,0" />

        <!-- Status Change + Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right">
            <ComboBox x:Name="StatusDropdown"
                      Width="150"
                      Margin="0,0,8,0">
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Processing"/>
                <ComboBoxItem Content="Completed"/>
                <ComboBoxItem Content="Cancelled"/>
            </ComboBox>

            <Button Content="Update Status"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="BtnUpdateStatus_Click"/>

            <Button Content="Refresh"
                    Width="100"
                    Click="BtnRefresh_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
