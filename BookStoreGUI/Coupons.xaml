<UserControl x:Class="BookStoreGUI.Pages.CouponsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="800">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <TextBlock Text="Coupons" FontSize="24" FontWeight="Bold"/>
        </StackPanel>

        <!-- MAIN GRID -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE: Data Grid -->
            <DataGrid x:Name="CouponsGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Margin="0 0 12 0"/>

            <!-- RIGHT SIDE: Form -->
            <StackPanel Grid.Column="1" Margin="12 0 0 0" VerticalAlignment="Top">

                <TextBlock Text="Code"/>
                <TextBox x:Name="TxtCode" Margin="0 0 0 8"/>

                <TextBlock Text="Description"/>
                <TextBox x:Name="TxtDescription" Margin="0 0 0 8"/>

                <TextBlock Text="Discount Rate (%)"/>
                <TextBox x:Name="TxtDiscountRate" Margin="0 0 0 8"/>

                <TextBlock Text="Usage Limit"/>
                <TextBox x:Name="TxtUsageLimit" Margin="0 0 0 8"/>

                <TextBlock Text="Times Used"/>
                <TextBox x:Name="TxtTimesUsed" Margin="0 0 0 8"/>

                <TextBlock Text="Start Date"/>
                <DatePicker x:Name="StartDatePicker" Margin="0 0 0 8"/>

                <TextBlock Text="End Date"/>
                <DatePicker x:Name="EndDatePicker" Margin="0 0 0 8"/>

                <StackPanel Orientation="Horizontal" Margin="0 8">
                    <CheckBox x:Name="ChkIsActive"/>
                    <TextBlock Text="Is Active" Margin="6 0"/>
                </StackPanel>

                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                    <Button Content="Add" Width="80" Margin="0 0 10 0" Click="BtnAdd_Click"/>
                    <Button Content="Edit" Width="80" Margin="0 0 10 0" Click="BtnEdit_Click"/>
                    <Button Content="Delete" Width="80" Click="BtnDelete_Click"/>
                </StackPanel>

            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
