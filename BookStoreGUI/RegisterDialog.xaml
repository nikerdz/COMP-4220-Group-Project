<Window x:Class="BookStoreGUI.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register New Account"
        Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA">

    <Border CornerRadius="10"
            BorderThickness="1"
            BorderBrush="#D6D6D6"
            Padding="20"
            Margin="10"
            Background="White"
            SnapsToDevicePixels="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Create an Account"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#2D2D2D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Full Name -->
                <TextBlock Text="Full Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFullName"
                         Height="30"
                         Background="White"
                         BorderBrush="#CFCFCF"
                         BorderThickness="1"
                         Padding="5"
                         Margin="0,0,0,12"/>

                <!-- Email -->
                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail"
                         Height="30"
                         Background="White"
                         BorderBrush="#CFCFCF"
                         BorderThickness="1"
                         Padding="5"
                         Margin="0,0,0,12"/>

                <!-- Username -->
                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername"
                         Height="30"
                         Background="White"
                         BorderBrush="#CFCFCF"
                         BorderThickness="1"
                         Padding="5"
                         Margin="0,0,0,12"/>

                <!-- Password -->
                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword"
                             Height="30"
                             Background="White"
                             BorderBrush="#CFCFCF"
                             BorderThickness="1"
                             Padding="5"
                             Margin="0,0,0,12"/>

                <!-- Confirm Password -->
                <TextBlock Text="Confirm Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtConfirmPassword"
                             Height="30"
                             Background="White"
                             BorderBrush="#CFCFCF"
                             BorderThickness="1"
                             Padding="5"
                             Margin="0,0,0,20"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Button x:Name="btnConfirm"
                            Content="Confirm"
                            Width="110"
                            Height="35"
                            Margin="8"
                            Background="#1976D2"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnConfirm_Click"/>

                    <Button x:Name="btnCancel"
                            Content="Cancel"
                            Width="110"
                            Height="35"
                            Margin="8"
                            Background="#E0E0E0"
                            Foreground="#333333"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnCancel_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
