<Window x:Class="BookStoreGUI.Pages.SupplierAddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplier" Height="160" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Supplier Name:" Margin="0 0 0 8"/>
            <TextBox x:Name="TxtName" Height="25"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button Content="OK" Width="70" Margin="5" Click="Ok_Click"/>
            <Button Content="Cancel" Width="70" Margin="5" Click="Cancel_Click"/>
        </StackPanel>

    </Grid>
</Window>
