<Window x:Class="BookStoreGUI.Pages.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Book" Height="487" Width="508"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="Add New Book"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- ISBN -->
            <StackPanel Margin="0,4">
                <TextBlock Text="ISBN:"/>
                <TextBox x:Name="TxtISBN"/>
            </StackPanel>

            <!-- CATEGORY DROPDOWN -->
            <StackPanel Margin="0,4">
                <TextBlock Text="Category:"/>
                <ComboBox x:Name="CategoryDropdown"
                          Height="28"
                          Width="Auto"
                          DisplayMemberPath="Name"
                          SelectedValuePath="CategoryID"/>
            </StackPanel>

            <!-- Title -->
            <StackPanel Margin="0,4">
                <TextBlock Text="Title:"/>
                <TextBox x:Name="TxtTitle"/>
            </StackPanel>

            <!-- Author -->
            <StackPanel Margin="0,4">
                <TextBlock Text="Author:"/>
                <TextBox x:Name="TxtAuthor"/>
            </StackPanel>

            <!-- Price -->
            <StackPanel Margin="0,4">
                <TextBlock Text="Price:"/>
                <TextBox x:Name="TxtPrice"/>
            </StackPanel>

            <!-- Year -->
            <StackPanel Margin="0,4">
                <TextBlock Text="Year:"/>
                <TextBox x:Name="TxtYear"/>
            </StackPanel>

            <!-- Edition -->
            <StackPanel Margin="0,4">
                <TextBlock Text="Edition:"/>
                <TextBox x:Name="TxtEdition"/>
            </StackPanel>

            <!-- Publisher -->
            <StackPanel Margin="0,4">
                <TextBlock Text="Publisher:"/>
                <TextBox x:Name="TxtPublisher"/>
            </StackPanel>

            <!-- Stock -->
            <StackPanel Margin="0,4">
                <TextBlock Text="Stock:"/>
                <TextBox x:Name="TxtStock"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="90"
                    Margin="0,12,12,0"
                    Click="BtnCancel_Click"/>

            <Button Content="Save"
                    Width="90"
                    Margin="0,12,0,0"
                    Background="#0275d8"
                    Foreground="White"
                    Click="BtnSave_Click"/>

        </StackPanel>
    </Grid>
</Window>
