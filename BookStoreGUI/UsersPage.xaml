<UserControl x:Class="BookStoreGUI.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Manage Users"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0 0 0 10"/>

        <DataGrid x:Name="UsersGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0 10 0 10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="UserID" Binding="{Binding UserID}" Width="80"/>
                <DataGridTextColumn Header="Username" Binding="{Binding UserName}" Width="140"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60"/>
                <DataGridTextColumn Header="Manager" Binding="{Binding Manager}" Width="70"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Add" Width="80" Margin="5" Click="BtnAdd_Click"/>
            <Button Content="Edit" Width="80" Margin="5" Click="BtnEdit_Click"/>
            <Button Content="Delete" Width="80" Margin="5" Click="BtnDelete_Click"/>
        </StackPanel>

    </Grid>
</UserControl>
