<Window x:Class="BookStoreGUI.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard"
        Height="720"
        Width="1180"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Background="#F3F4F6" LastChildFill="False">
            <TextBlock Text="BookStore Admin Dashboard"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="18"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtCurrentUser"
                           Text="Admin"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"/>

                <Button x:Name="BtnLogout"
                        Content="Logout"
                        Width="80"
                        Click="BtnLogout_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- LEFT MENU -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="#EDEDED" Margin="12">


            <TextBlock Text="Menu"
                       FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <Button Content="Inventory"
                    Margin="0,6"
                    Padding="8"
                    Click="NavInventory_Click"/>

            <Button Content="Categories"
                    Margin="0,6"
                    Padding="8"
                    Click="NavCategories_Click"/>

            <Button Content="Suppliers"
                    Margin="0,6"
                    Padding="8"
                    Click="NavSuppliers_Click"/>
            
            <Button Content="Offers"
                    Margin="0,6"
                    Padding="8"
                    Click="NavOffers_Click"/>

            <Button Content="Users"
                    Margin="0,6"
                    Padding="8"
                    Click="NavUsers_Click"/>

            <Button Content="Orders"
                    Margin="0,6"
                    Padding="8"
                    Click="NavOrders_Click"/>

        </StackPanel>

        <!-- MAIN CONTENT HOST -->
        <ContentControl x:Name="ContentHost"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12"/>
    </Grid>

</Window>
